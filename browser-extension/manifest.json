{
  "manifest_version": 3,
  "name": "QRShield AI URL Analyzer",
  "version": "1.0",
  "description": "Analyze the current tab URL using QRShield AI backend.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1/*"]
}
